to run task1 add loop like this 
run it like this ./healthcheck.sh
#!/bin/bash

PATH=/usr/bin:/bin:/usr/local/bin

URL="http://localhost:8000/ping"
LOG_FILE="/home/prateek/Prateek/LaunchPad/week1/Day5/task1/logs/health.log"

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Send request
while true; do
    if curl -fs --max-time 5 "$URL" > /dev/null; then
        echo "[$TIMESTAMP] ✔ Healthy"
    else
        echo "[$TIMESTAMP] FAILED to reach $URL" >> "$LOG_FILE"
    fi

    sleep 10
done


# how to run a cron job ?
crontab -e

*/1 * * * * /home/prateek/Prateek/LaunchPad/week1/Day5/task1/healthcheck.sh
this will run every 1 min
to stop just comment it with #

